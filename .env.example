# Base de dados (Vercel Postgres — Storage > Create Database > Postgres no dashboard Vercel)
# Depois de criar, usa o botão "Connect" para obter estas duas variáveis.
POSTGRES_URL=              # ligação pooled (via PgBouncer) — usada em runtime
POSTGRES_URL_NON_POOLING=  # ligação direta — usada só pelo Prisma Migrate

# Utilizador admin inicial (criado por `pnpm db:seed` — só corre uma vez, é idempotente)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo para assinar o cookie de sessão do admin (gera com: openssl rand -base64 32)
SESSION_SECRET=

# Segredo para o cookie de sessão do formando (gera com: openssl rand -base64 32)
# Independente do SESSION_SECRET do admin — sessões de admin e de formando nunca se misturam.
FORMANDO_SESSION_SECRET=

# Armazenamento de ficheiros (Supabase Storage — mesmo projeto usado pela TROKA API,
# ver troka-api/.env: SUPABASE_URL/SUPABASE_SERVICE_KEY. Usa a service_role key,
# não a public/anon key, para poder criar o bucket e fazer upload a partir do servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Segredo partilhado com o academy (BackOffice) para invalidar o cache das
# páginas públicas depois de uma escrita feita por lá (o academy escreve
# direto no Postgres, sem passar pelas Server Actions daqui — ver
# docs/superpowers/specs/2026-09-19-backoffice-universal-f1-cursos-turmas-design.md
# no repo academy). Gera com: openssl rand -base64 32
REVALIDATE_SECRET=

# URL público do academy (BackOffice universal) — o portal de formando deste
# repo (/portal/login, /portal/registar, /portal/recuperar-password,
# /portal/definir-password) passa a redirecionar para lá. Ver
# docs/superpowers/specs/2026-09-21-backoffice-universal-f2-f3-formandos-empresas-design.md
# no repo academy.
ACADEMY_URL=

# Envio de newsletter por SMTP (credenciais do teu fornecedor de email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CPLP CONNECT <newsletter@cplpconnect.pt>"

# URL pública do site (usada em links de cancelamento de subscrição nos emails)
NEXT_PUBLIC_SITE_URL=https://cplpconnect.pt
