# Base de dados (Vercel Postgres — Storage > Create Database > Postgres no dashboard Vercel)
# Depois de criar, usa o botão "Connect" para obter estas duas variáveis.
POSTGRES_URL=              # ligação pooled (via PgBouncer) — usada em runtime
POSTGRES_URL_NON_POOLING=  # ligação direta — usada só pelo Prisma Migrate

# Utilizador admin inicial (criado por `pnpm db:seed` — só corre uma vez, é idempotente)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo para assinar o cookie de sessão do admin (gera com: openssl rand -base64 32)
SESSION_SECRET=

# Armazenamento de ficheiros (Vercel Blob — Storage > Create Database > Blob no dashboard Vercel)
BLOB_READ_WRITE_TOKEN=

# Envio de newsletter por SMTP (credenciais do teu fornecedor de email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CPLP CONNECT <newsletter@cplpconnect.pt>"

# URL pública do site (usada em links de cancelamento de subscrição nos emails)
NEXT_PUBLIC_SITE_URL=https://cplpconnect.pt
